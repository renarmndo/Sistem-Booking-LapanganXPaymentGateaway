APP_ENV=development
APP_PORT=8080
TZ=Asia/Jakarta

DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASS=app_password
DB_NAME=football_booking

REDIS_ADDR=localhost:6379
REDIS_PASS=redis_password

JWT_SECRET=change-me-with-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

MIDTRANS_SERVER_KEY=change-me
MIDTRANS_CLIENT_KEY=change-me
MIDTRANS_IS_PRODUCTION=false

BOOKING_PAYMENT_TTL_MIN=15
ALLOWED_ORIGINS=http://localhost:5173

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Football Booking
SMTP_FROM_EMAIL=no-reply@example.com
OTP_TTL_MINUTES=15
OTP_RESEND_COOLDOWN_MINUTES=1
OTP_MAX_ATTEMPTS_PER_HOUR=3
OTP_VERIFY_MAX_ATTEMPTS=5

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
